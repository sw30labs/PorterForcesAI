# Exact model id or alias returned by GET /v1/models.
PFA_LLM_MODEL=Qwen3.8-27B-4bit
PFA_LLM_BASE_URL=http://127.0.0.1:8000/v1
PFA_LLM_API_KEY=test
PFA_LLM_TIMEOUT_SECONDS=180

# Search requests leave the machine. Never place confidential facts here.
PFA_SEARCH_REGION=us-en
PFA_SEARCH_MAX_RESULTS=8
PFA_SEARCH_TIMEOUT_SECONDS=15

# Local application services. The API deliberately rejects non-loopback binding.
PFA_API_HOST=127.0.0.1
PFA_API_PORT=8765
PFA_UI_ORIGIN=http://127.0.0.1:3000
PFA_DATABASE_PATH=data/porter-forces.db
PFA_ARTIFACTS_DIR=runs
PFA_ANALYSIS_MAX_CONCURRENCY=1

# Ralph supervisor bounds.
PFA_RALPH_MAX_ATTEMPTS=3
PFA_RALPH_MAX_BUDGET_UNITS=6
PFA_RALPH_STALL_LIMIT=2

# Production profile example (do not enable until its oMLX model is loaded):
# PFA_LLM_MODEL=DeepSeek-V4-Flash-0731-MXFP4-MLX
